--' Pac-Man
--'
--' The only module that names both an engine and a frontend. Everything it
--' does is choose an implementation, hand it to the frontend, and own the save
--' file. No other module in this program opens a file.
module main (run)

import .lib.pacman
import .lib.pacman-rust
import .lib.tui
import root-rust

--' \ The file to resume from and save to.
--' @arg -f/--file
--' @name save
--' @metavar SAVE
--' @default "pacman.sav"
type SaveFile = Str

--' Play Pac-Man.
--'
--' \ A game is resumed from the save file if one is readable, and written back
--' \ when you leave with `s`.
run :: SaveFile -> <IO, Err> ()
run path = do
  -- FINDINGS #1: `fresh` is bound rather than written inline so that the two
  -- arms of the `@catch` below capture a local each. Written inline, both arms
  -- close over `path` and the second one fails to borrow it.
  let fresh = withSaveFile path (newGame 3)
  s0 <- resume path fresh
  r <- tuiRun commands s0
  eachE (toSave r) saveOne

--' Read a saved game, or start the one we were given.
resume :: Str -> GameState -> <IO> GameState
resume path fresh = @catch (@load path :: <IO, Err> GameState) fresh

--' Write one game to its own save file.
saveOne :: GameState -> <IO, Err> ()
saveOne s = @save 0 (.savefile s) s
