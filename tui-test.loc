--' Renders frames off-screen. Exercises the drawing code with no terminal.
module tui-test (frame, ending, onward)

import .lib.pacman
import .lib.pacman-rust
import .lib.tui
import root-rust

--' A fresh board.
frame :: Int -> Int -> <IO> [Str]
frame w h = tuiFrame commands (newGame 3) w h

--' The tally shown when a game is lost.
ending :: Int -> Int -> <IO> [Str]
ending w h = tuiFrame commands lostGame w h

--' The tally shown when a level is cleared, which offers a way on.
onward :: Int -> Int -> <IO> [Str]
onward w h = tuiFrame commands clearedGame w h

lostGame :: GameState
lostGame = runCommands (replicate 400 cmdTick) (runCommands [cmdLeft] (newGame 3))

clearedGame :: GameState
clearedGame = .(.outcome = 1, .pellets = 0) (newGame 3)
