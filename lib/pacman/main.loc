--' The Pac-Man interface: what a game engine must provide and what a frontend
--' may rely on. Pure morloc, no language mappings, no implementations.
module (*)

import root

--' A player instruction. The engine interprets these; a frontend obtains one
--' from `keyOf` and never constructs one itself.
--'
--' \ `None` is what an unrecognised key becomes, and is inert. `Tick` advances
--' \ the world one frame with no player input. `Quit` leaves without writing a
--' \ save file and `Save` leaves and writes one. `Continue` starts the next
--' \ level and means nothing until one is cleared.
data Command
  = None
  | Up
  | Down
  | Left
  | Right
  | Tick
  | Quit
  | Save
  | Continue

--' A ghost. `kind` selects the targeting rule (0 Blinky, 1 Pinky, 2 Inky,
--' 3 Clyde); `state` is 0 in the house, 1 hunting, 2 frightened, 3 eyes
--' returning home. `timer` counts down whatever the state is waiting on.
record Ghost where
  pos :: (Int, Int)
  dir :: Int
  kind :: Int
  state :: Int
  timer :: Int

--' The whole world. Everything needed to draw a frame or resume a game, and
--' nothing else -- so a save file is exactly this record.
record GameState where
  maze :: [Str]
  pac :: (Int, Int)
  dir :: Int
  want :: Int
  ghosts :: [Ghost]
  score :: Int
  lives :: Int
  pellets :: Int
  fright :: Int
  chain :: Int
  phase :: Int
  ticks :: Int
  seed :: Int
  outcome :: Int
  savefile :: Str
  level :: Int

--' How hard a level plays. Everything that changes with the level number and
--' nothing that does not: the maze is a separate matter, and the rules are the
--' same on every board.
record Difficulty where
  --' A hunting ghost stands still on every Nth frame. Zero means it never
  --' does, which is full speed; one would freeze it, so one is not allowed.
  ghostSkip :: Int
  --' A frightened ghost moves on every Nth frame, so larger is slower.
  frightMove :: Int
  --' How long an energizer frightens, in frames. Zero means it scores and
  --' nothing more, which is where the arcade ends up deep in a game.
  frightTicks :: Int
  --' Frames each ghost waits in the house before leaving, one per ghost.
  release :: [Int]
  --' Scatter and chase durations in frames, alternating, scatter first. The
  --' last is however long the game has left.
  phases :: [Int]

--' One drawable frame. The engine decides what the screen says; a frontend
--' only paints it.
record Frame where
  rows :: [Str]
  status :: Str
  done :: Bool
  save :: Bool
  --' Lines to show in place of the board. Empty while a game is running; at the
  --' end it holds the tally. Unlike `rows`, which is a map of tiles a frontend
  --' draws however it likes, these are literal text.
  message :: [Str]

--' The engine, as a value. A frontend receives one of these and calls nothing
--' else. Every field is pure, so a frontend can render, replay, or rewind
--' without asking permission.
record PacmanCommands where
  newGame :: Int -> GameState
  keyOf :: Str -> Command
  step :: Command -> GameState -> GameState
  view :: GameState -> Frame

--' Start a game with the given number of lives.
newGame :: Int -> GameState

--' The map for a level: 31 rows of 28 tiles, '#' wall, '.' dot, 'o' energizer,
--' '-' ghost-house door, ' ' open. Level 1 is the arcade board; every level
--' after it is generated from its number, so the same number always gives the
--' same map. A map it returns always satisfies `mazeProblems`.
makeMaze :: Int -> [Str]

--' How a level plays. Level one is the arcade's opening pace; later levels get
--' harder. Like `makeMaze`, this is one function of the level number, so the
--' whole difficulty curve is a plugin. A value it returns always satisfies
--' `difficultyProblems`.
levelDifficulty :: Int -> Difficulty

--' Everything wrong with a difficulty, empty when it can be played.
difficultyProblems :: Difficulty -> [Str]

--' Everything wrong with a map, empty when it is fit to play. This is the
--' definition of a valid map, so a generator can be checked against it and a
--' hand-drawn map can be checked before anyone tries to play it.
mazeProblems :: [Str] -> [Str]

--' Translate a key name ("up", "a", "Escape", ...) into a command. An
--' unrecognised name is `None`.
keyOf :: Str -> Command

--' Apply one command. Total: an illegal move is a no-op, not an error.
step :: Command -> GameState -> GameState

--' Render the world.
view :: GameState -> Frame

--' Point a game at a save file.
withSaveFile :: Str -> GameState -> GameState

--' The engine bundled for a frontend.
commands :: PacmanCommands
commands = ({newGame = newGame, keyOf = keyOf, step = step, view = view} :: PacmanCommands)

--' The form in which a game is written out. A saved game is stored mid-play:
--' the outcome that ended the session is not part of it, or resuming would land
--' on a finished board.
forSaving :: GameState -> GameState

--' Apply a whole script of commands. This is the entire frontend contract for
--' a non-interactive driver: tests and replays need nothing more.
runCommands :: [Command] -> GameState -> GameState
runCommands cs s = fold (flip step) s cs

--' Translate a script of key names, then run it.
runKeys :: [Str] -> GameState -> GameState
runKeys ks = runCommands (map keyOf ks)
